<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{% if doc.title %}{{ doc.title }}{% else %}{{ title }}{% endif %} · PMLL</title>
  <style>
    :root { --bg: #0d1117; --fg: #c9d1d9; --muted: #8b949e; --accent: #58a6ff; --line: #21262d; --card: #161b22; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
           background: var(--bg); color: var(--fg); line-height: 1.65; }
    a { color: var(--accent); }
    .top { border-bottom: 1px solid var(--line); }
    .top-inner { max-width: 1080px; margin: 0 auto; display: flex; gap: 1.25rem; align-items: center; min-height: 3.25rem; padding: 0 1.25rem; }
    .brand { color: var(--fg); text-decoration: none; font-weight: 650; }
    .layout { max-width: 1080px; margin: 0 auto; display: grid; grid-template-columns: 240px 1fr; gap: 2rem; padding: 1.75rem 1.25rem 4rem; }
    .side a { display: block; color: var(--muted); text-decoration: none; padding: .2rem 0; font-size: .92rem; }
    .side a:hover, .side a[aria-current="page"] { color: var(--accent); }
    .side h2 { color: var(--muted); font-size: .75rem; letter-spacing: .06em; text-transform: uppercase; margin: 1.1rem 0 .35rem; }
    .content h1 { color: var(--accent); margin-bottom: .6rem; font-size: 1.8rem; }
    .lede { color: var(--muted); margin-bottom: 1rem; }
    .meta { color: var(--muted); font-size: .85rem; margin-bottom: 1.25rem; }
    .doc h1, .doc h2, .doc h3 { margin: 1.4rem 0 .5rem; color: #e6edf3; }
    .doc p, .doc ul, .doc ol, .doc pre, .doc table { margin-bottom: 1rem; }
    .doc ul, .doc ol { padding-left: 1.3rem; }
    .doc li { margin: .2rem 0; }
    .doc code { background: var(--card); padding: .12em .35em; border-radius: 4px; font-size: .9em; }
    .doc pre { background: var(--card); padding: .9rem 1rem; border-radius: 8px; overflow-x: auto; }
    .doc pre code { background: transparent; padding: 0; }
    .doc table { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; }
    .doc th, .doc td { border: 1px solid var(--line); padding: .4rem .6rem; text-align: left; }
    .index-list { list-style: none; }
    .index-list a { text-decoration: none; }
    .index-list li { padding: .45rem 0; border-bottom: 1px solid var(--line); }
    .num { color: var(--muted); display: inline-block; width: 2rem; }
    .pager { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid var(--line); }
    .pager a { text-decoration: none; }
    .pager .count { color: var(--muted); }
    @media (max-width: 760px) {
      .layout { grid-template-columns: 1fr; }
      .side { order: 2; }
    }
  </style>
</head>
<body>
  <header class="top">
    <div class="top-inner">
      <a class="brand" href="{{ '/' | url }}">PMLL</a>
      <a href="{{ '/docs/' | url }}">Docs</a>
    </div>
  </header>
  <div class="layout">
    <nav class="side" aria-label="Documentation">
      {% set sections = ["Core", "Guides", "API", "Notes"] %}
      {% for section in sections %}
        <h2>{{ section }}</h2>
        {% for item in docPages %}
          {% if item.section == section %}
            {% set itemPath = "/docs/" + item.slug + "/" %}
            {% set itemUrl = itemPath | url %}
            <a href="{{ itemUrl }}"{% if page.url == itemUrl %} aria-current="page"{% endif %}>{{ item.title }}</a>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </nav>
    <main class="content">
      {{ content | safe }}
    </main>
  </div>
</body>
</html>
