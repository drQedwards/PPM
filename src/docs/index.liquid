---
title: Documentation
permalink: /docs/
layout: docs.liquid
---
<h1>Documentation</h1>
<p class="lede">One topic per page, in reading order. The text is the markdown already in the repo.</p>
{% assign sections = "Core,Guides,API,Notes" | split: "," %}
{% for section in sections %}
  <h2>{{ section }}</h2>
  <ol class="index-list">
    {% for item in docPages %}
      {% if item.section == section %}
        {% assign itemPath = "/docs/" | append: item.slug | append: "/" %}
        <li><span class="num">{{ item.n }}</span><a href="{{ itemPath | url }}">{{ item.title }}</a></li>
      {% endif %}
    {% endfor %}
  </ol>
{% endfor %}
